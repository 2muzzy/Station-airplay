#!/bin/sh
# Luna owns supervision; YAM owns the immutable files. No init hooks here.
set -eu
umask 077
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
state=${LUNA_PLUGIN_STATE:?Luna binary host with writable plugin state is required}
case "$state" in /*) ;; *) echo 'LUNA_PLUGIN_STATE must be absolute' >&2; exit 2;; esac
mkdir -p "$state"
config=$state/airplay-controls.json
# Seed atomically and repair an empty file left by an interrupted first
# launch: an EOF controls file used to wedge the service on every boot.
# Stock firmware has the Quasar CLI; emulators usually do not. Detect it once
# and seed the full feature set only where it can actually work.
if [ ! -s "$config" ]; then
    model=
    if command -v wget >/dev/null 2>&1; then
        model=$(wget -qO- http://127.0.0.1:8099/api/device 2>/dev/null | sed -n 's/.*"model":"//; s/".*//p' | head -n1)
    fi
    tmp=$config.tmp.$$
    cat "$here/config/airplay-controls-v2.json" > "$tmp"
    if [ -x /system/vendor/quasar/q ]@@MANGO_GUARD@@; then
        sed 's/"native_player": false/"native_player": true/' "$tmp" > "$tmp.q"
        mv -f "$tmp.q" "$tmp"
        # Keep this list in sync with source/alice_button.go.
        case "$model" in
            yandexmini_2|yandexplum|yandexstation_2|yandexmidi)
                sed 's/"alice_button": false/"alice_button": true/' "$tmp" > "$tmp.a"
                mv -f "$tmp.a" "$tmp"
                ;;
        esac
    fi
    mv -f "$tmp" "$config"
fi
@@DBUS_EXPORT@@
@@SLEEP_LINES@@
exec "$here/bin/station-airplay" --shared-audio@@CONTROLS_CONFIG@@
